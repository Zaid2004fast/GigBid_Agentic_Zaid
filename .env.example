# Copy to .env and fill in. NEVER commit .env. Every variable GigBid reads is listed here.

# --- profile & models -------------------------------------------------------
GIGBID_PROFILE=open                 # open (required) | open_local | paid (optional) | offline (CI, no LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_SMALL_MODEL=qwen3:1.7b
SMALL_PROVIDER=ollama               # set to groq on GPU-less hosts (Hugging Face Spaces)
SMALL_MODEL=qwen3:1.7b               # e.g. openai/gpt-oss-20b with SMALL_PROVIDER=groq
WRITER_PROVIDER=groq                # hosted open-model provider for the deployed link (no GPU on free hosts)
WRITER_MODEL=openai/gpt-oss-120b
CRITIC_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=                     # only for the optional paid profile
EMBED_PROVIDER=fastembed            # fastembed (BAAI/bge-small-en-v1.5) | hash (tests only)
RERANK_PROVIDER=fastembed
RAG_VARIANT=best

# --- marketplace ------------------------------------------------------------
MARKETPLACE_MODE=gigsim             # gigsim | upwork_live
GIGSIM_URL=http://gigsim:8100       # or "inprocess" for single-container deployments
GIGSIM_ADMIN_TOKEN=
GIGSIM_SPEED=6
GIGSIM_ERROR_RATE=0.02
GIGSIM_POLICY_VERSION=1
UPWORK_CLIENT_ID=                   # optional; dynamic client registration is used when empty
UPWORK_CLIENT_SECRET=

# --- MCP --------------------------------------------------------------------
MCP_TRANSPORT=http                  # http (docker) | inprocess (single container / tests)
MCP_SERVER_TOKEN=                   # shared bearer token for the MCP HTTP endpoints
PORTFOLIO_MCP_URL=http://mcp-portfolio:8201/mcp
MARKETPLACE_MCP_URL=http://mcp-marketplace:8202/mcp
WORKSPACE_MCP_URL=http://mcp-workspace:8203/mcp
GITHUB_MCP_ENABLED=false
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- app --------------------------------------------------------------------
DATABASE_URL=postgresql://gigbid:gigbid@postgres:5432/gigbid
VECTOR_STORE=pgvector               # numpy | pgvector
REDIS_URL=redis://redis:6379
SECRET_KEY=                         # >= 32 random bytes
TOKEN_ENC_KEY=                      # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
GIGBID_ENV=prod
COOKIE_SECURE=1
CORS_ORIGINS=http://localhost:5173
REVIEWER_EMAIL=reviewer@gigbid.dev
REVIEWER_PASSWORD=                  # share privately with the grader, never in the repo
REVIEWER_PERSONA=aiml

# --- observability ----------------------------------------------------------
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
PHOENIX_UI_URL=http://localhost:6006