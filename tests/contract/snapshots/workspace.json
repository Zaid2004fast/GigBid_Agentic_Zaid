{
 "create_email_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "input": {
   "$defs": {
    "EmailDraftIn": {
     "properties": {
      "body": {
       "maxLength": 5000,
       "minLength": 10,
       "title": "Body",
       "type": "string"
      },
      "idempotency_key": {
       "maxLength": 128,
       "minLength": 8,
       "title": "Idempotency Key",
       "type": "string"
      },
      "subject": {
       "maxLength": 150,
       "minLength": 3,
       "title": "Subject",
       "type": "string"
      },
      "to_name": {
       "maxLength": 80,
       "minLength": 1,
       "title": "To Name",
       "type": "string"
      }
     },
     "required": [
      "to_name",
      "subject",
      "body",
      "idempotency_key"
     ],
     "title": "EmailDraftIn",
     "type": "object"
    }
   },
   "properties": {
    "draft": {
     "$ref": "#/$defs/EmailDraftIn"
    }
   },
   "required": [
    "draft"
   ],
   "title": "create_email_draftArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "draft_id": {
     "title": "Draft Id",
     "type": "string"
    },
    "status": {
     "title": "Status",
     "type": "string"
    },
    "subject": {
     "title": "Subject",
     "type": "string"
    }
   },
   "required": [
    "draft_id",
    "subject",
    "status"
   ],
   "title": "EmailDraft",
   "type": "object"
  }
 },
 "create_interview_hold": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "input": {
   "$defs": {
    "HoldIn": {
     "properties": {
      "duration_minutes": {
       "default": 30,
       "maximum": 120,
       "minimum": 15,
       "title": "Duration Minutes",
       "type": "integer"
      },
      "idempotency_key": {
       "maxLength": 128,
       "minLength": 8,
       "title": "Idempotency Key",
       "type": "string"
      },
      "start": {
       "description": "ISO-8601 start, must be one of the offered free slots",
       "title": "Start",
       "type": "string"
      },
      "title": {
       "maxLength": 120,
       "minLength": 3,
       "title": "Title",
       "type": "string"
      }
     },
     "required": [
      "start",
      "title",
      "idempotency_key"
     ],
     "title": "HoldIn",
     "type": "object"
    }
   },
   "properties": {
    "hold": {
     "$ref": "#/$defs/HoldIn"
    }
   },
   "required": [
    "hold"
   ],
   "title": "create_interview_holdArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "end": {
     "title": "End",
     "type": "string"
    },
    "event_id": {
     "title": "Event Id",
     "type": "string"
    },
    "start": {
     "title": "Start",
     "type": "string"
    },
    "status": {
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "event_id",
    "start",
    "end",
    "status"
   ],
   "title": "Hold",
   "type": "object"
  }
 },
 "free_slots": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "input": {
   "properties": {
    "days": {
     "default": 5,
     "maximum": 14,
     "minimum": 1,
     "title": "Days",
     "type": "integer"
    },
    "duration_minutes": {
     "default": 30,
     "maximum": 120,
     "minimum": 15,
     "title": "Duration Minutes",
     "type": "integer"
    },
    "max_slots": {
     "default": 3,
     "maximum": 10,
     "minimum": 1,
     "title": "Max Slots",
     "type": "integer"
    },
    "timezone": {
     "default": "Asia/Karachi",
     "maxLength": 40,
     "title": "Timezone",
     "type": "string"
    }
   },
   "title": "free_slotsArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "Slot": {
     "properties": {
      "end": {
       "title": "End",
       "type": "string"
      },
      "label": {
       "title": "Label",
       "type": "string"
      },
      "start": {
       "description": "ISO-8601 with timezone",
       "title": "Start",
       "type": "string"
      }
     },
     "required": [
      "start",
      "end",
      "label"
     ],
     "title": "Slot",
     "type": "object"
    }
   },
   "properties": {
    "slots": {
     "items": {
      "$ref": "#/$defs/Slot"
     },
     "title": "Slots",
     "type": "array"
    },
    "timezone": {
     "title": "Timezone",
     "type": "string"
    }
   },
   "required": [
    "timezone",
    "slots"
   ],
   "title": "Slots",
   "type": "object"
  }
 }
}
