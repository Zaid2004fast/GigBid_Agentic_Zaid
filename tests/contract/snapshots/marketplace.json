{
 "create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "input": {
   "$defs": {
    "ProposalDraftIn": {
     "properties": {
      "bid_amount": {
       "exclusiveMinimum": 0,
       "maximum": 1000000,
       "title": "Bid Amount",
       "type": "number"
      },
      "cover_letter": {
       "maxLength": 5000,
       "minLength": 50,
       "title": "Cover Letter",
       "type": "string"
      },
      "dry_run": {
       "default": false,
       "title": "Dry Run",
       "type": "boolean"
      },
      "idempotency_key": {
       "description": "Unique per logical action; retries with the same key are no-ops",
       "maxLength": 128,
       "minLength": 8,
       "pattern": "^[A-Za-z0-9:_\\-.]+$",
       "title": "Idempotency Key",
       "type": "string"
      },
      "job_id": {
       "maxLength": 64,
       "minLength": 3,
       "title": "Job Id",
       "type": "string"
      },
      "screening_answers": {
       "items": {
        "type": "string"
       },
       "maxItems": 10,
       "title": "Screening Answers",
       "type": "array"
      }
     },
     "required": [
      "job_id",
      "cover_letter",
      "bid_amount",
      "idempotency_key"
     ],
     "title": "ProposalDraftIn",
     "type": "object"
    }
   },
   "properties": {
    "proposal": {
     "$ref": "#/$defs/ProposalDraftIn"
    }
   },
   "required": [
    "proposal"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "connects_balance_after": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Connects Balance After"
    },
    "connects_cost": {
     "default": 0,
     "title": "Connects Cost",
     "type": "integer"
    },
    "idempotency_key": {
     "title": "Idempotency Key",
     "type": "string"
    },
    "preview": {
     "additionalProperties": true,
     "description": "Exactly what is/would be sent",
     "title": "Preview",
     "type": "object"
    },
    "result": {
     "additionalProperties": true,
     "title": "Result",
     "type": "object"
    },
    "status": {
     "enum": [
      "dry_run",
      "draft_created",
      "submitted",
      "sent",
      "replayed"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "status",
    "idempotency_key"
   ],
   "title": "WriteResult",
   "type": "object"
  }
 },
