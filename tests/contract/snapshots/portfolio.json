 "search_evidence": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "input": {
   "$defs": {
    "EvidenceFilters": {
     "properties": {
      "industry": {
       "anyOf": [
        {
         "maxLength": 40,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Industry"
      },
      "outcome": {
       "anyOf": [
        {
         "enum": [
          "won",
          "replied",
          "ignored"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Outcome"
      },
      "persona": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Portfolio owner id; defaults to the caller's persona",
       "title": "Persona"
      },
      "since": {
       "anyOf": [
        {
         "pattern": "^\\d{4}(-\\d{2})?$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Only evidence dated on/after YYYY or YYYY-MM",
       "title": "Since"
      },
      "types": {
       "anyOf": [
        {
         "items": {
          "enum": [
           "case_study",
           "cv",
           "repo_readme",
           "repo_code",
           "review",
           "proposal"
          ],
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Restrict to these evidence types",
       "title": "Types"
      }
     },
     "title": "EvidenceFilters",
     "type": "object"
    }
   },
   "properties": {
    "filters": {
     "anyOf": [
      {
       "$ref": "#/$defs/EvidenceFilters"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "k": {
     "default": 5,
     "maximum": 20,
     "minimum": 1,
     "title": "K",
     "type": "integer"
    },
    "requirement": {
     "description": "One job requirement, e.g. 'Celery background workers'",
     "maxLength": 400,
     "minLength": 2,
     "title": "Requirement",
     "type": "string"
    }
   },
   "required": [
    "requirement"
   ],
   "title": "search_evidenceArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "EvidenceItem": {
     "properties": {
      "client_industry": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Client Industry"
      },
      "date": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Date"
      },
      "item_id": {
       "description": "Stable id, e.g. aiml:cs:docs-assistant; use with get_case_study or resources",
       "title": "Item Id",
       "type": "string"
      },
      "outcome": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "For past proposals: won | replied | ignored",
       "title": "Outcome"
      },
      "project": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Project"
      },
      "score": {
       "title": "Score",
       "type": "number"
      },
      "snippet": {
       "title": "Snippet",
       "type": "string"
      },
      "source": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Source"
      },
      "support": {
       "description": "0-1: share of the requirement's skills this project is proven to have",
       "title": "Support",
       "type": "number"
      },
      "title": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Title"
      },
      "type": {
       "title": "Type",
       "type": "string"
      }
     },
     "required": [
      "item_id",
      "type",
      "source",
      "date",
      "project",
      "title",
      "snippet",
      "score",
      "support"
     ],
     "title": "EvidenceItem",
     "type": "object"
    }
   },
   "properties": {
    "items": {
     "items": {
      "$ref": "#/$defs/EvidenceItem"
     },
     "title": "Items",
     "type": "array"
    },
    "requirement": {
     "title": "Requirement",
     "type": "string"
    },
    "status": {
     "enum": [
      "supported",
      "partial",
      "none"
     ],
     "title": "Status",
     "type": "string"
    },
    "variant": {
     "title": "Variant",
     "type": "string"
    }
   },
   "required": [
    "requirement",
    "variant",
    "status",
    "items"
   ],
   "title": "SearchEvidenceResult",
   "type": "object"
  }
 }
}
